    user_response: "Here is the full initial file tree for the application:\n/.env.example\n/.gitignore\n/assets/.aistudio/.gitignore\n/bun.lock\n/data/persistent_layers.json\n/data/persistent_reports.json\n/firebase-applet-config.json\n/firebase-blueprint.json\n/firestore.rules\n/index.html\n/metadata.json\n/package.json\n/public/nia-logo.svg\n/public/nia-official.svg\n/server.ts\n/src/App.tsx\n/src/components/AnalyticsDashboard.tsx\n/src/components/AttributeInspector.tsx\n/src/components/FieldReportModal.tsx\n/src/components/GoogleDriveModal.tsx\n/src/components/GoogleFormsModal.tsx\n/src/components/HelpModal.tsx\n/src/components/LayerPanel.tsx\n/src/components/LocationFilterModal.tsx\n/src/components/MapContainer.tsx\n/src/components/Navbar.tsx\n/src/components/SpatialAIAssistant.tsx\n/src/components/UploadModal.tsx\n/src/data/sampleLayers.ts\n/src/db/drizzle.config.ts\n/src/db/index.ts\n/src/db/schema.ts\n/src/db/users.ts\n/src/index.css\n/src/lib/firebase-admin.ts\n/src/lib/firebase.ts\n/src/lib/firebaseStore.ts\n/src/lib/googleDriveService.ts\n/src/lib/googleFormsService.ts\n/src/lib/serverDriveUploader.ts\n/src/main.tsx\n/src/middleware/auth.ts\n/src/types.ts\n/src/utils/gisLocationUtils.ts\n/src/utils/kmzParser.ts\n/src/utils/offlineStorage.ts\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@tailwindcss/vite: ^4.1.14\n@tmcw/togeojson: ^7.1.2\n@types/leaflet: ^1.9.22\n@types/pg: ^8.21.0\n@vitejs/plugin-react: ^5.0.4\ndotenv: ^17.2.3\ndrizzle-kit: ^0.31.10\ndrizzle-orm: ^0.45.2\nexpress: ^4.21.2\nfirebase: ^12.17.1\nfirebase-admin: ^14.2.0\njszip: ^3.10.1\nleaflet: ^1.9.4\nlucide-react: ^0.546.0\nmotion: ^12.23.24\npg: ^8.23.0\nreact: ^19.0.1\nreact-dom: ^19.0.1\nrecharts: ^3.10.1\nvite: ^6.2.3\n\nThe following devDependencies are installed:\n@types/express: ^4.17.21\n@types/node: ^22.14.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.1.14\ntsx: ^4.21.0\ntypescript: ~5.8.2\nvite: ^6.2.3\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n# GOOGLE_DRIVE_FOLDER_ID: Target Google Drive folder for automated unauthenticated report uploads.\nGOOGLE_DRIVE_FOLDER_ID=\"16Xs6u4O1Un1UrkvsvBzdf6WnqQHN_zhi\"\n\n# GOOGLE_DRIVE_ACCESS_TOKEN: Optional pre-configured Google Drive access token for server-side uploads.\nGOOGLE_DRIVE_ACCESS_TOKEN=\n\n# Long-term Google Drive Sync OAuth Credentials (for automatic background auto-refresh)\nGOOGLE_CLIENT_ID=\nGOOGLE_CLIENT_SECRET=\nGOOGLE_REFRESH_TOKEN=\n\n# Cloud SQL PostgreSQL database variables (Automatically injected by platform)\nSQL_HOST=\nSQL_USER=\nSQL_PASSWORD=\nSQL_DB_NAME=\nSQL_ADMIN_USER=\nSQL_ADMIN_PASSWORD=\n\n```\n\n--- /firebase-applet-config.json ---\n```json\n{\n  \"projectId\": \"perfect-volt-1t3g1\",\n  \"appId\": \"1:518397636928:web:7b708bba2ab7be69c14aa5\",\n  \"apiKey\": \"AIzaSyD14vGu6jiO5qkAuKDIlPXcsheWurxJfFo\",\n  \"authDomain\": \"perfect-volt-1t3g1.firebaseapp.com\",\n  \"storageBucket\": \"perfect-volt-1t3g1.firebasestorage.app\",\n  \"messagingSenderId\": \"518397636928\",\n  \"measurementId\": \"\",\n  \"oAuthClientId\": \"518397636928-5ia1margooh50oi5ohsgmgdlf292ll1k.apps.googleusercontent.com\",\n  \"recaptchaSiteKey\": \"\"\n}\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n    <title>NIA R4B O&amp;M GIS - Field Data Crowdsourcing</title>\n    <!-- Leaflet CSS -->\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" integrity=\"sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=\" crossorigin=\"\" />\n    <!-- Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body class=\"bg-slate-900 text-slate-100 antialiased selection:bg-cyan-500 selection:text-slate-900\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"O\\u0026M Map to Antigravity\",\n  \"description\": \"Google Maps style GIS workspace supporting KMZ/GeoJSON vector layers, desilting work \\u0026 land parcel field reports, spatial analytics, and offline field synchronization.\",\n  \"requestFramePermissions\": [\n    \"geolocation\"\n  ],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect, useMemo, useCallback } from \'react\';\nimport { \n  UserRole, \n  BasemapType, \n  GISLayer, \n  FieldReport,\n  LocationFilter\n} from \'./types\';\nimport { INITIAL_GIS_LAYERS, INITIAL_FIELD_REPORTS } from \'./data/sampleLayers\';\nimport { \n  getOfflineReports, \n  addOfflineReport, \n  markReportsSynced,\n  getCachedLayers, \n  saveCachedLayers, \n  getCachedLayersDB,\n  saveCachedLayersDB,\n  syncOfflineQueueToServer,\n  isMockLayer\n} from \'./utils/offlineStorage\';\nimport { getAccessToken, uploadMaintenanceReportToDrive } from \'./lib/googleDriveService\';\n\nimport { Navbar } from \'./components/Navbar\';\nimport { MapContainer } from \'./components/MapContainer\';\nimport { LayerPanel } from \'./components/LayerPanel\';\nimport { AttributeInspector } from \'./components/AttributeInspector\';\nimport { UploadModal } from \'./components/UploadModal\';\nimport { FieldReportModal } from \'./components/FieldReportModal\';\nimport { AnalyticsDashboard } from \'./components/AnalyticsDashboard\';\nimport { SpatialAIAssistant } from \'./components/SpatialAIAssistant\';\nimport { HelpModal } from \'./components/HelpModal\';\nimport { LocationFilterModal } from \'./components/LocationFilterModal\';\nimport { GoogleDriveModal } from \'./components/GoogleDriveModal\';\nimport { GoogleFormsModal } from \'./components/GoogleFormsModal\';\n\nfunction deduplicateItems<T extends { id: string }>(items: T[]): T[] {\n  if (!Array.isArray(items)) return [];\n  const map = new Map<string, T>();\n  for (const item of items) {\n    if (item && item.id) {\n      map.set(item.id, item);\n    }\n  }\n  return Array.from(map.values());\n}\n\nexport default function App() {\n  // App State\n  const [layers, setLayersState] = useState<GISLayer[]>([]);\n  const [fieldReports, setFieldReportsState] = useState<FieldReport[]>([]);\n\n  const setLayers = useCallback((action: React.SetStateAction<GISLayer[]>) => {\n    setLayersState(prev => {\n      const next = typeof action === \'function\' ? action(prev) : action;\n      return deduplicateItems(next);\n    });\n  }, []);\n\n  const setFieldReports = useCallback((action: React.SetStateAction<FieldReport[]>) => {\n    setFieldReportsState(prev => {\n      const next = typeof action === \'function\' ? action(prev) : action;\n      return deduplicateItems(next);\n    });\n  }, []);\n  const [basemap, setBasemap] = useState<BasemapType>(\'satellite\');\n  const [currentRole, setCurrentRole] = useState<UserRole>(\'Admin\');\n  const [isOffline, setIsOffline] = useState<boolean>(false);\n  const [isSyncing, setIsSyncing] = useState<boolean>(false);\n\n  // Search\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [searchTargetCoords, setSearchTargetCoords] = useState<[number, number] | undefined>(undefined);\n\n  // Selection\n  const [selectedFeatureProps, setSelectedFeatureProps] = useState<any>(null);\n  const [selectedFeatureType, setSelectedFeatureType] = useState<string>(\'\');\n  const [selectedReport, setSelectedReport] = useState<FieldReport | undefined>(undefined);\n  const [selectedCoords, setSelectedCoords] = useState<[number, number] | undefined>(undefined);\n\n  // Modals & Panels\n  const [isLayerPanelOpen, setIsLayerPanelOpen] = useState(false);\n  const [isUploadOpen, setIsUploadOpen] = useState(false);\n  const [isReportModalOpen, setIsReportModalOpen] = useState(false);\n  const [isAnalyticsOpen, setIsAnalyticsOpen] = useState(false);\n  const [isAIAssistantOpen, setIsAIAssistantOpen] = useState(false);\n  const [isDriveModalOpen, setIsDriveModalOpen] = useState(false);\n  const [isFormsModalOpen, setIsFormsModalOpen] = useState(false);\n  const [isHelpOpen, setIsHelpOpen] = useState(false);\n  const [isFilterModalOpen, setIsFilterModalOpen] = useState(false);\n\n  // Location Filter State\n  const [locationFilter, setLocationFilter] = useState<LocationFilter>({\n    imo: \'All IMOs\',\n    nis: \'All NIS\',\n    province: \'All Provinces\',\n    municipality: \'All Municipalities\',\n    barangay: \'All Barangays\'\n  });\n\n  const isFilterActive = useMemo(() => {\n    return Boolean(\n      (locationFilter.imo && locationFilter.imo !== \'All IMOs\') ||\n      (locationFilter.nis && locationFilter.nis !== \'All NIS\') ||\n      (locationFilter.province && locationFilter.province !== \'All Provinces\') ||\n      (locationFilter.municipality && locationFilter.municipality !== \'All Municipalities\') ||\n      (locationFilter.barangay && locationFilter.barangay !== \'All Barangays\')\n    );\n  }, [locationFilter]);\n\n  // Map Picker State\n  const [isMapPickerActive, setIsMapPickerActive] = useState(false);\n  const [mapPickerMode, setMapPickerMode] = useState<\'single\' | \'double\'>(\'single\');\n  const [mapPickerReportType, setMapPickerReportType] = useState<\'maintenance\' | \'operational\'>(\'maintenance\');\n\n  // Prefill params for report modal\n  const [reportPrefill, setReportPrefill] = useState<{\n    lat?: number;\n    lng?: number;\n    lat2?: number;\n    lng2?: number;\n    canalSegment?: string;\n    parcelId?: string;\n    reportType?: \'maintenance\' | \'operational\';\n  }>({});\n\n  // 1. Initial Load from Backend API or Offline Storage\n  useEffect(() => {\n    async function loadData() {\n      // Try loading layers from Express server\n      let serverLayers: GISLayer[] | null = null;\n      try {\n        const res = await fetch(\'/api/layers\');\n        if (res.ok) {\n          const data = await res.json();\n          if (data.layers && data.layers.length > 0) {\n            serverLayers = data.layers.filter((l: any) => !isMockLayer(l));\n          }\n        }\n      } catch (err) {\n        console.warn(\'Backend server offline or unreachable for layers.\', err);\n      }\n\n      // Try loading from IndexedDB\n      const rawLocalCached = await getCachedLayersDB();\n      const localCached = rawLocalCached ? rawLocalCached.filter(l => !isMockLayer(l)) : null;\n\n      if (serverLayers && serverLayers.length > 0) {\n        // If server layers exist, merge with any local custom layers in IndexedDB\n        if (localCached && localCached.length > 0) {\n          const serverIds = new Set(serverLayers.map(l => l.id));\n          const localOnly = localCached.filter(l => !serverIds.has(l.id));\n          if (localOnly.length > 0) {\n            console.log(`Found ${localOnly.length} local-only layer(s). Auto-syncing to cloud database...`);\n            const merged = [...serverLayers, ...localOnly];\n            setLayers(merged);\n            await saveCachedLayersDB(merged);\n            // Sync local custom layers to server\n            for (const missingLayer of localOnly) {\n              try {\n                await fetch(\'/api/layers\', {\n                  method: \'POST\',\n                  headers: { \'Content-Type\': \'application/json\' },\n                  body: JSON.stringify(missingLayer)\n                });\n              } catch (e) {\n                console.warn(\'Sync missing layer to server error\', e);\n              }\n            }\n            return;\n          }\n        }\n        setLayers(serverLayers);\n        await saveCachedLayersDB(serverLayers);\n      } else if (localCached && localCached.length > 0) {\n        // Fallback to IndexedDB if server returns empty or offline, then push to server\n        setLayers(localCached);\n        for (const missingLayer of localCached) {\n          fetch(\'/api/layers\', {\n            method: \'POST\',\n            headers: { \'Content-Type\': \'application/json\' },\n            body: JSON.stringify(missingLayer)\n          }).catch(e => console.warn(\'Sync cached layer error\', e));\n        }\n      } else {\n        // Fallback to empty array\n        setLayers([]);\n        await saveCachedLayersDB([]);\n      }\n\n      // Try loading reports from Express server\n      try {\n        const res = await fetch(\'/api/reports\');\n        if (res.ok) {\n          const data = await res.json();\n          if (data.reports) {\n            // Merge server reports with local unsynced offline reports\n            const offline = getOfflineReports().filter(r => !r.synced);\n            setFieldReports([...offline, ...data.reports]);\n          }\n        }\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', system-ui, -apple-system, sans-serif;\n  }\n  h1, h2, h3, h4, h5, h6, .font-heading {\n    font-family: \'Outfit\', \'Plus Jakarta Sans\', system-ui, sans-serif;\n  }\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: rgba(15, 23, 42, 0.6);\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(51, 65, 85, 0.8);\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(71, 85, 105, 1);\n}\n\n/* Leaflet Custom Map Overrides */\n.leaflet-container {\n  font-family: \'Plus Jakarta Sans\', sans-serif !important;\n  background-color: #0f172a !important;\n  width: 100%;\n  height: 100%;\n  z-index: 1;\n}\n\n.leaflet-control-zoom {\n  border: none !important;\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5) !important;\n  border-radius: 12px !important;\n  overflow: hidden;\n}\n\n.leaflet-control-zoom-in, .leaflet-control-zoom-out {\n  background-color: #1e293b !important;\n  color: #e2e8f0 !important;\n  border: 1px solid #334155 !important;\n  width: 36px !important;\n  height: 36px !important;\n  line-height: 36px !important;\n  font-size: 16px !important;\n  transition: all 0.2s ease;\n}\n\n.leaflet-control-zoom-in:hover, .leaflet-control-zoom-out:hover {\n  background-color: #334155 !important;\n  color: #38bdf8 !important;\n}\n\n.leaflet-popup-content-wrapper {\n  background-color: #0f172a !important;\n  color: #f8fafc !important;\n  border: 1px solid #334155 !important;\n  border-radius: 12px !important;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 8px 10px -6px rgba(0, 0, 0, 0.5) !important;\n  padding: 4px !important;\n}\n\n.leaflet-popup-tip {\n  background-color: #0f172a !important;\n  border: 1px solid #334155 !important;\n}\n\n.leaflet-popup-close-button {\n  color: #94a3b8 !important;\n  padding: 8px 8px 0 0 !important;\n}\n\n.leaflet-popup-close-button:hover {\n  color: #f1f5f9 !important;\n}\n\n.leaflet-tooltip {\n  background-color: #1e293b !important;\n  border: 1px solid #475569 !important;\n  color: #f8fafc !important;\n  border-radius: 6px !important;\n  font-size: 12px !important;\n  font-weight: 500 !important;\n  padding: 4px 8px !important;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3) !important;\n}\n\n.leaflet-container .leaflet-control-attribution {\n  background: rgba(15, 23, 42, 0.8) !important;\n  color: #64748b !important;\n  font-size: 10px !important;\n  backdrop-filter: blur(4px);\n  padding: 2px 8px !important;\n  border-top-left-radius: 6px !important;\n}\n\n.leaflet-container .leaflet-control-attribution a {\n  color: #38bdf8 !important;\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
