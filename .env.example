# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_DRIVE_FOLDER_ID: Target Google Drive folder for automated unauthenticated report uploads.
GOOGLE_DRIVE_FOLDER_ID="16Xs6u4O1Un1UrkvsvBzdf6WnqQHN_zhi"

# GOOGLE_DRIVE_ACCESS_TOKEN: Optional pre-configured Google Drive access token for server-side uploads.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Long-term Google Drive Sync OAuth Credentials (for automatic background auto-refresh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cloud SQL PostgreSQL database variables (Automatically injected by platform)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
